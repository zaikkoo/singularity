{
    "layer": "top",
	"width": 850,
	"margin-top": 10,
    "modules-left": [
        "pulseaudio",
        "cava"
    ],
    "modules-center": [
        "clock",
        "hyprland/workspaces",
        "clock#right"
    ],
    "modules-right": [
        "battery",
		"network",
		"custom/power"
    ],
    "clock": {
        "format": "{:%H}"
    },
    "clock#right": {
        "format": "{:%M}"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": ""
        }
    },
    "battery": {
	"interval": 60,
	"format": "{icon}  {capacity}% ",
	"format-icons": {
		"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
		"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
	    }
    },
    "pulseaudio": {
	"format": "{icon}  {volume}%",
	"format-bluetooth": " {volume}%",
	"format-muted": "",
	"format-icons": {
		"headphone": "",
		"hands-free": "󰂑",
		"headset": "󰂑",
		"phone": "",
		"phone-muted": "",
		"portable": "",
		"car": "",
		"default": ["󰖀", "󰕾"]
	},
	"scroll-step": 1,
	"on-click": "pavucontrol"
    },
    "cava": {
	//"cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
	"framerate": 30,
	"autosens": 0,
	"sensitivity": 2,
	"bars": 12,
	"lower_cutoff_freq": 50,
	"higher_cutoff_freq": 10000,
    "hide_on_silence": false,
	"method": "pulse",
	"source": "auto",
	"stereo": true,
	"reverse": false,
    "bar_delimiter": 0,
	"monstercat": false,
	"waves": false,
	"noise_reduction": 0.11,
	"input_delay": 2,
	"format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
	"actions": {
		"on-click-right": "mode"
	    }
    },
	"custom/power": {
	"format" : "⏻ ",
	"tooltip": false,
	"menu": "on-click",
	"menu-file": "~/.config/waybar/power_menu.xml",
	"menu-actions": {
		"shutdown": "shutdown",
		"reboot": "reboot",
		"suspend": "systemctl suspend",
		"hibernate": "systemctl hibernate"
		}
	},
	"network": {
	"format-wifi": "",
	"format-ethernet": "",
	"format-disconnected": "󱚼",
	"tooltip-format-wifi": "{essid} ({signalStrength}%) ",
	"tooltip-format-ethernet": "Connected via Ethernet ",
	"tooltip-format-disconnected": "Disconnected",
	"max-length": 50
	}
}
